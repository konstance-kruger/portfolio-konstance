---
// Structure commune du portfolio Astro.

import '../styles/style.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  wide = false,
  description = 'Portfolio de Konstance Kruger, étudiante en BUT MMI : production audiovisuelle et événementielle avec CAPS, vie étudiante avec SPAC, WebTV et créations.'
} = Astro.props;

// RÉFÉRENCEMENT — Adresse canonique et image de partage : seulement quand le nom
// de domaine est renseigné dans astro.config.mjs (site: 'https://…').
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr" data-theme="konstance">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- FAVICON ET PARTAGE — Icône d'onglet ; titre et description repris par LinkedIn,
         Instagram ou une messagerie quand on partage le lien. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f0c6de" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Konstance Kruger — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <!-- TYPOGRAPHIES — Uniquement General Sans et Melodrama (Fontshare).
         Trois liens séparés : si l'un échoue, les deux autres polices restent chargées. -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@300,400,500,600,700&display=swap" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@301&display=swap" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=melodrama@400,500,700&display=swap" />

    <!-- ANIMATIONS — On active le mode animé avant l'affichage (pas de clignotement).
         Sécurité : si le script du magazine ne démarre pas en 3 s, tout redevient visible. -->
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('js-anim');
        setTimeout(function () {
          if (!window.__magReady) document.documentElement.classList.remove('js-anim');
        }, 3000);
      }
    </script>
  </head>

  <body>
    <!-- Accès clavier au contenu -->
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <!-- En-tête commun (masqué sur le magazine) -->
    <Header />

    <!-- Contenu de la page -->
    <main id="contenu" class:list={[wide ? 'narrative' : 'container detail-main']}>
      <slot />
    </main>

    <!-- Pied de page (masqué sur le magazine) -->
    <Footer />

    <!-- Navigation mobile -->
    <script>
      import '../scripts/navigation.js';
    </script>
  </body>
</html>