---
// MÉDIAS — Affiche une image, ou une vidéo muette en boucle (l'image sert alors d'affiche).
// Props :
// - file  : image dans public/assets/images/ (ex. "caps/caps-equipe.webp")
// - alt   : texte alternatif lu par les lecteurs d'écran
// - video : vidéo dans public/assets/videos/ (ex. "caps-presentation.mp4") ; si elle existe, elle remplace l'image
// - fit   : "cover" (remplit le cadre, par défaut) ou "contain" (image entière)
// Le fichier est cherché depuis la racine du projet (process.cwd()) au moment du build.
// La lecture et la pause des vidéos sont gérées par grid-site.js (IntersectionObserver).
import { existsSync } from 'node:fs';
import path from 'node:path';

const { file, alt = '', video = '', fit = 'cover' } = Astro.props;

const root = process.cwd();
const videoExists = video ? existsSync(path.join(root, 'public/assets/videos', video)) : false;
const imageSrc = `/assets/images/${file}`;
const videoSrc = `/assets/videos/${video}`;
---
{videoExists ? (
  <div class:list={['media', 'media--video', `media--${fit}`]}>
    <video src={videoSrc} poster={imageSrc} muted loop playsinline preload="none" aria-label={alt}></video>
  </div>
) : (
  <img class:list={['media', `media--${fit}`]} src={imageSrc} alt={alt} loading="lazy" decoding="async" />
)}
